<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose paints the UI; the platform theme only needs to avoid a flash of
         the wrong colour before the first frame. -->
    <style name="Theme.SiyuanRemote" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
